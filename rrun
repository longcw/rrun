#!/usr/bin/env bash
# rrun: sync the current project to a remote host, run a command there, stream its logs.
# The command runs detached on the remote (own process group, log + pid under ~/.rrun/<name>/),
# so a dropped connection never kills it; the local side reconnects and keeps streaming.
set -euo pipefail

VERSION=0.5.0
HOME_CFG="${RRUN_CONFIG:-$HOME/.config/rrun/config}"

say() { printf '\033[1;36m[rrun]\033[0m %s\n' "$*" >&2; }
die() { printf '\033[1;31m[rrun]\033[0m %s\n' "$*" >&2; exit 1; }

usage() {
    cat <<'USAGE'
rrun [-H host] [-d dir] [-n run | -N] [-y] <command...>
                                sync the project, run <command> on the remote, stream its logs
                                Ctrl-C once stops it (SIGINT) and streams until it has exited; twice kills it

A project has a default run, shown as <project>, and starting it replaces the previous one. -n <run>
uses another slot, shown as <project>:<run>, that runs alongside; -N picks a generated name. Every
subcommand below acts on the default run unless a run name is given.

  attach | logs [run]           re-attach to a run's logs (last 200 lines, then follow)
  stop [run]                    SIGINT the run and stream logs until it is down
  kill [run]                    SIGKILL the run
  status [run]                  is the run alive, its processes or exit code
  ps [-a]                       this project's runs on the host; -a: every project
  clean [run]                   remove the project's run state on the host (stops it first); or one run
  killall                       stop every rrun-managed run on the host (SIGINT, then SIGKILL)
  sync                          rsync only
  exec <command...>             run <command> attached with a tty (interactive, not logged)
  sh                            shell in the remote project dir
  setup                         install rsync on the host if missing and create the project dir
  init                          write a .rrun.conf template into the project
  -y                            skip the first-sync confirmation for a folder that has no .rrun.conf
  update                        reinstall the latest rrun from GitHub
  -d <dir>                      remote folder for this project; saved to .rrun.conf for next time
                                (default: <root>/<folder name>, root = ~/rrun or `root = ...` in the config)

The first sync from a folder without a .rrun.conf shows what would be uploaded and asks first;
confirming writes the .rrun.conf. `rrun exec` never syncs.

Commands are joined and run with `bash -lc` in the remote project dir, so quote pipes:
  rrun 'curl -LsSf https://astral.sh/uv/install.sh | sh'

Hosts: -H takes an ssh target plus ssh options (rrun -H root@vps -p 2222 -i ~/.ssh/k <cmd>), or a
name from ~/.config/rrun/config, which is a list of `name = target [ssh options]` lines plus
`default = name`, optionally `root = <parent folder for projects on the host>` and `log_max = 50M`
(run logs rotate past this size, keeping one previous copy; 0 disables). Project: .rrun.conf in the root (host, dir, name, env, filter lines) and
.rrunignore (gitignore-like, `!pattern` re-includes). Git-ignored files are not synced, except
.env and .env.local.
USAGE
}

# ---------------------------------------------------------------- config
find_root() {
    local d="$PWD"
    while [ "$d" != "/" ]; do
        [ -f "$d/.rrun.conf" ] && { echo "$d"; return; }
        d=$(dirname "$d")
    done
    git rev-parse --show-toplevel 2>/dev/null || pwd
}

ROOT=$(find_root)
host="" dir="" name="" env="" log_max="" filt_paths=() filt_cmds=()
# `filter <file> <command>` in .rrun.conf: the file is not rsynced; it is piped through the command
# (a function from the conf or any shell command) and the output written to the same path on the host
filter() { filt_paths+=("$1"); filt_cmds+=("$2"); }
# shellcheck disable=SC1091
[ -f "$ROOT/.rrun.conf" ] && . "$ROOT/.rrun.conf"
cfg() { [ -f "$HOME_CFG" ] || return 0; sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$HOME_CFG" | tail -n 1; }

spec="${RRUN_HOST:-}" dir_arg="" run="" yes=""
while [ $# -gt 0 ]; do
    case "$1" in
        -d|--dir) dir_arg="$2"; shift 2 ;;
        -y|--yes) yes=1; shift ;;
        -n|--name) run="$2"; shift 2 ;;
        -N|--new) run="run-$(od -An -tx1 -N2 /dev/urandom | tr -d ' \n')"; shift ;;
        -H|--host)
            spec="$2"; shift 2
            # ssh options right after the target belong to it: rrun -H root@vps -p 2222 -i ~/.ssh/k <cmd>
            while [ $# -gt 0 ]; do
                case "$1" in
                    -p|-i|-o|-J|-l|-F|-c|-m|-b|-D|-L|-R|-w|-W|-e|-I|-S|-B|-E|-P) spec="$spec $1 $2"; shift 2 ;;
                    -4|-6|-A|-a|-C|-K|-k|-M|-N|-q|-T|-t|-X|-x|-Y|-y|-G|-g) spec="$spec $1"; shift ;;
                    *) break ;;
                esac
            done ;;
        -V|--version) echo "rrun $VERSION"; exit 0 ;;
        -h|--help|help) usage; exit 0 ;;
        --) shift; break ;;
        *) break ;;
    esac
done

# host spec: -H > RRUN_HOST > .rrun.conf host= > default= in the home config; a first word that
# names an entry in the home config is replaced by that entry, so `-H vps -p 2222` still works
[ -n "$spec" ] || spec="$host"
[ -n "$spec" ] || spec="$(cfg default)"
[ -n "$spec" ] || die "no host: pass -H <user@host [ssh options]> or set default= in $HOME_CFG"
first="${spec%% *}"
if [ -n "$(cfg "$first")" ]; then spec="$(cfg "$first")${spec#"$first"}"; fi
target="${spec%% *}"; ssh_extra="${spec#"$target"}"
name="${name:-$(basename "$ROOT")}"
run="${run:-default}"; key="$name/$run"   # state lives at ~/.rrun/<project>/<run>/ on the host
log_max="${log_max:-$(cfg log_max)}"; log_max="${log_max:-50M}"
case "$log_max" in
    *[Gg]) log_bytes=$(( ${log_max%[Gg]} * 1024 * 1024 * 1024 )) ;;
    *[Mm]) log_bytes=$(( ${log_max%[Mm]} * 1024 * 1024 )) ;;
    *[Kk]) log_bytes=$(( ${log_max%[Kk]} * 1024 )) ;;
    *) log_bytes=$(( log_max )) ;;
esac
if [ -n "$dir_arg" ]; then
    dir="$dir_arg"
    case "$dir" in "$HOME"/*) dir="~${dir#"$HOME"}" ;; esac   # `~/x` was expanded by the local shell
    # remember it: replace an existing dir= line in .rrun.conf or append one
    if [ -f "$ROOT/.rrun.conf" ] && grep -q '^dir=' "$ROOT/.rrun.conf"; then
        awk -v d="$dir" '/^dir=/ { print "dir=\047" d "\047"; next } { print }' "$ROOT/.rrun.conf" > "$ROOT/.rrun.conf.tmp" \
            && mv "$ROOT/.rrun.conf.tmp" "$ROOT/.rrun.conf"
    else
        printf "dir='%s'\n" "$dir" >> "$ROOT/.rrun.conf"
    fi
    say "remote dir $dir saved to $ROOT/.rrun.conf"
fi
root="$(cfg root)"; root="${root:-~/rrun}"
dir="${dir:-$root/$name}"
case "$dir" in "$HOME"/*) dir="~${dir#"$HOME"}" ;; esac   # `dir=~/x` in a conf expands locally; undo that
mkdir -p "$HOME/.rrun"
SSH_OPTS="-o ControlMaster=auto -o ControlPath=~/.rrun/cm-%C -o ControlPersist=10m $ssh_extra"
# shellcheck disable=SC2206
SSH=(ssh $SSH_OPTS "$target")

# ---------------------------------------------------------------- remote side
# These run on the host; they are shipped with `declare -f` in every call, nothing is installed there.
r_label() { case "$1" in */default) echo "${1%/default}" ;; *) echo "${1%/*}:${1##*/}" ;; esac; }
r_pgid() { local p; p=$(cat "$HOME/.rrun/$1/pid" 2>/dev/null) && kill -0 -- "-$p" 2>/dev/null && echo "$p"; }
r_stop() { local p; p=$(r_pgid "$1") || return 0; kill "-$2" -- "-$p" 2>/dev/null || true; }
r_gone() { local i; for i in $(seq "$2"); do r_pgid "$1" >/dev/null || return 0; sleep 0.3; done; return 1; }
r_start() {  # key dir env log_max_bytes command
    local n=$1 d env=$3 max=$4 cmd=$5 st="$HOME/.rrun/$1"; eval "d=$2"
    mkdir -p "$st"
    r_stop "$n" INT; r_gone "$n" 200 || r_stop "$n" KILL
    : > "$st/log"; rm -f "$st/exit" "$st/log.1" "$st/gen"; printf '%s\n' "$cmd" > "$st/cmd"
    cd "$d" 2>/dev/null || { echo "[rrun] remote dir $d is missing; run: rrun setup"; return 1; }
    [ -n "$env" ] && eval "export $env"
    # the wrapper stays the group leader; the INT trap keeps it alive to record the exit code.
    # a side loop rotates the log by copy + truncate when it passes $max bytes (the command keeps
    # its open fd; O_APPEND makes writes continue at the new end) and counts rotations in "gen"
    local w='st=$1 max=$2; shift 2; trap ":" INT; echo $$ > "$st/pid"
        if [ "$max" -gt 0 ]; then ( trap "" INT; while sleep 5 && [ ! -e "$st/exit" ]; do
            sz=$(stat -c %s "$st/log" 2>/dev/null || wc -c < "$st/log"); [ "$sz" -gt "$max" ] || continue
            cp "$st/log" "$st/log.1" && : > "$st/log"; echo $(( $(cat "$st/gen" 2>/dev/null || echo 0) + 1 )) > "$st/gen"
        done ) 2>/dev/null & fi
        bash -lc "$1"; echo $? > "$st/exit"; pkill -P $! 2>/dev/null; wait'
    # setsid --fork rather than `&`: a shell background job inherits SIGINT ignored, and that
    # would pass down to the command, so Ctrl-C could never stop it
    if setsid --help 2>&1 | grep -q -- --fork; then
        setsid -f bash -c "$w" _ "$st" "$max" "$cmd" >> "$st/log" 2>&1 < /dev/null
    else
        setsid bash -c "$w" _ "$st" "$max" "$cmd" >> "$st/log" 2>&1 < /dev/null &
    fi
    local i; for i in $(seq 50); do { r_pgid "$n" >/dev/null || [ -e "$st/exit" ]; } && break; sleep 0.1; done
}
r_follow() {  # key from   (from = "gen:lines", or -1 for the last 200 lines); exits 0 once the run is over
    local st="$HOME/.rrun/$1" from=$2 p t total gen lines
    [ -e "$st/log" ] || { echo "[rrun] no run $(r_label "$1") on $(hostname)"; return 0; }
    gen=$(cat "$st/gen" 2>/dev/null || echo 0)
    total=$(wc -l < "$st/log")
    if [ "$from" = "-1" ]; then lines=$(( total > 200 ? total - 200 : 0 ))
    elif [ "${from%%:*}" = "$gen" ]; then lines=${from#*:}
    else lines=0; echo "[rrun] log was rotated, continuing from the current file"; fi
    printf '\001rrun:from=%s gen=%s\n' "$lines" "$gen"
    if p=$(r_pgid "$1"); then
        tail -n +$((lines + 1)) -f "$st/log" 2>/dev/null & t=$!
        while kill -0 -- "-$p" 2>/dev/null; do sleep 0.3; done
        sleep 0.5; kill "$t" 2>/dev/null; wait "$t" 2>/dev/null || true
    else
        tail -n +$((lines + 1)) "$st/log"
    fi
    if [ -e "$st/exit" ]; then echo "[rrun] $(r_label "$1") exited with code $(cat "$st/exit")"; else echo "[rrun] $(r_label "$1") exited (killed)"; fi
}
r_exit() { cat "$HOME/.rrun/$1/exit" 2>/dev/null || echo 137; }
r_status() {  # key
    local p st="$HOME/.rrun/$1"
    [ -e "$st/cmd" ] || { echo "[rrun] no run $(r_label "$1") on $(hostname)"; return 0; }
    if p=$(r_pgid "$1"); then
        echo "[rrun] $(r_label "$1") running on $(hostname), pgid $p: $(cat "$st/cmd")"
        ps -eo pid,pgid,etime,args | awk -v g="$p" 'NR == 1 || $2 == g' | cut -c1-160
    else
        echo "[rrun] $(r_label "$1") stopped on $(hostname), exit $(cat "$st/exit" 2>/dev/null || echo killed): $(cat "$st/cmd")"
    fi
}
r_ps() {  # [project]   one line per run, all projects unless one is given
    local d k p any=""
    for d in "$HOME"/.rrun/${1:-*}/*/; do
        [ -e "$d/cmd" ] || continue
        [ -n "$any" ] || { any=1; printf '%-30s %-8s %-11s %s\n' RUN STATE PGID/EXIT COMMAND; }
        k=${d%/}; k=${k#"$HOME"/.rrun/}
        if p=$(r_pgid "$k"); then printf '%-30s %-8s %-11s %s\n' "$(r_label "$k")" running "$p" "$(cat "$d/cmd")"
        else printf '%-30s %-8s %-11s %s\n' "$(r_label "$k")" stopped "exit $(cat "$d/exit" 2>/dev/null || echo killed)" "$(cat "$d/cmd")"; fi
    done
    [ -n "$any" ] || echo "[rrun] no runs${1:+ of $1} on $(hostname)"
}
r_killall() {
    local d k any=""
    for d in "$HOME"/.rrun/*/*/; do
        [ -e "$d/cmd" ] || continue
        k=${d%/}; k=${k#"$HOME"/.rrun/}
        r_pgid "$k" >/dev/null && { any=1; echo "[rrun] stopping $(r_label "$k"): $(cat "$d/cmd")"; r_stop "$k" INT; }
    done
    [ -n "$any" ] || { echo "[rrun] nothing running on $(hostname)"; return 0; }
    for d in "$HOME"/.rrun/*/*/; do
        [ -e "$d/cmd" ] || continue
        k=${d%/}; k=${k#"$HOME"/.rrun/}
        r_gone "$k" 100 || { echo "[rrun] killing $(r_label "$k")"; r_stop "$k" KILL; }
    done
    echo "[rrun] all stopped"
}
r_clean() {  # project or project/run: stop whatever is running there, then remove the state
    local d k any=""
    for d in "$HOME"/.rrun/$1/*/ "$HOME"/.rrun/$1/; do
        [ -e "$d/cmd" ] || continue
        any=1; k=${d%/}; k=${k#"$HOME"/.rrun/}
        r_pgid "$k" >/dev/null && { echo "[rrun] stopping $(r_label "$k")"; r_stop "$k" INT; r_gone "$k" 100 || r_stop "$k" KILL; }
    done
    [ -n "$any" ] || [ -d "$HOME/.rrun/$1" ] || { echo "[rrun] no state for $1 on $(hostname)"; return 0; }
    rm -rf "$HOME/.rrun/$1"; echo "[rrun] removed ~/.rrun/$1 on $(hostname)"
}
r_setup() {  # dir
    local d; eval "d=$1"; mkdir -p "$d" "$HOME/.rrun"
    command -v rsync >/dev/null && { echo "[rrun] $(hostname): rsync present, $d ready"; return 0; }
    echo "[rrun] installing rsync on $(hostname)"
    if command -v apt-get >/dev/null; then DEBIAN_FRONTEND=noninteractive apt-get install -y -qq rsync
    elif command -v dnf >/dev/null; then dnf install -y -q rsync
    elif command -v yum >/dev/null; then yum install -y -q rsync
    elif command -v apk >/dev/null; then apk add -q rsync
    elif command -v pacman >/dev/null; then pacman -S --noconfirm --quiet rsync
    else echo "[rrun] no known package manager; install rsync by hand"; return 1; fi
}
R_LIB=$(declare -f r_label r_pgid r_stop r_gone r_start r_follow r_exit r_status r_ps r_killall r_clean r_setup)

# one probe per invocation: a host that is down or misnamed fails here with ssh's reason on one line,
# instead of surfacing later as a wall of rsync errors; it also opens the multiplexed connection
checked=""
check_host() {
    [ -z "$checked" ] || return 0
    local err; err=$(mktemp)
    "${SSH[@]}" -o ConnectTimeout=15 true 2>"$err" || die "cannot reach $target: $(grep -v '^[[:space:]]*$' "$err" | tail -n 1)"
    rm -f "$err"; checked=1
}
remote() {  # run one r_* function on the host; args are re-quoted so spaces survive
    check_host
    "${SSH[@]}" bash -s <<REMOTE
$R_LIB
$(printf '%q ' "$@")
REMOTE
}

# ---------------------------------------------------------------- local side
label="$(r_label "$key")"

write_conf() {
    cat >> "$ROOT/.rrun.conf" <<'TPL'
# rrun project config (sourced by bash). Every line is optional; the file marks this folder as a project.
# host=vps                 # a name from ~/.config/rrun/config, or "user@host [ssh options]"
# dir=~/rrun/<name>        # where the project lives on the host (`rrun -d <dir>` writes this line)
# name=<dir basename>      # key for the run state under ~/.rrun/<name> on the host
# env=""                   # exported before every remote command, e.g. env="UV_PYTHON=3.13"
# log_max=50M              # rotate the run log past this size (one previous copy kept as log.1); 0 = never
# filter .env "sed 's/^API_URL=.*/API_URL=https:\/\/prod.example/'"
#                          # a file is not rsynced but piped through a command (or a function defined
#                          # here) and the output written to the same path on the host; repeatable
TPL
}

sync() {
    check_host
    local ex; ex=$(mktemp); local err; err=$(mktemp); local inc=() exc=() l
    if git -C "$ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        # everything git ignores stays local, except env files
        git -C "$ROOT" ls-files -o -i --exclude-standard --directory | grep -vE '(^|/)\.env(\.local)?$' | sed 's|^|/|' > "$ex" || true
        echo "/.git" >> "$ex"
    fi
    if [ -f "$ROOT/.rrunignore" ]; then
        while IFS= read -r l; do
            case "$l" in ''|'#'*) ;; '!'*) inc+=(--include="${l#!}") ;; *) exc+=(--exclude="$l") ;; esac
        done < "$ROOT/.rrunignore"
    fi
    local i=0 f
    for f in ${filt_paths[@]+"${filt_paths[@]}"}; do exc+=(--exclude="/$f"); done
    set -- -az --delete -e "ssh $SSH_OPTS" --rsync-path="mkdir -p $dir && rsync" \
        ${inc[@]+"${inc[@]}"} ${exc[@]+"${exc[@]}"} --exclude-from="$ex" "$ROOT/" "$target:$dir/"
    # a folder without .rrun.conf has never been synced from: show what would go up and ask first
    if [ ! -f "$ROOT/.rrun.conf" ]; then
        local n sz; n=$(rsync -n --stats "$@" 2>/dev/null | awk -F': ' '/Number of files/ {n=$2} /Total file size/ {printf "%s files, %s", n, $2}')
        say "first sync from $ROOT (no .rrun.conf here): ${n:-? files} -> $target:$dir"
        [ "$ROOT" != "$HOME" ] || say "this is your home directory"
        if [ -z "$yes" ]; then
            [ -t 0 ] || die "not syncing without confirmation: run interactively, pass -y, or create .rrun.conf (rrun init)"
            printf '\033[1;36m[rrun]\033[0m sync it? [y/N] ' >&2; read -r l </dev/tty
            case "$l" in y|Y|yes) ;; *) die "not synced. \`rrun exec <cmd>\` runs on the host without syncing; \`rrun -d <dir>\` picks the remote folder" ;; esac
        fi
        write_conf; say "wrote $ROOT/.rrun.conf; this folder is now an rrun project"
    fi
    say "syncing $ROOT -> $target:$dir"
    rsync -v "$@" 2>"$err" \
        | awk '/\/$/ {next} /^(sent|total|building|Transfer|deleting|receiving|sending)/ {next} NF {print "  " $0; n++} END {printf "  %d file(s) changed\n", n}' >&2 \
        || die "rsync to $target:$dir failed: $(grep -vE '^rsync\(|^[[:space:]]*$' "$err" | head -n 1) (no rsync on the host? try: rrun setup)"
    rm -f "$ex" "$err"
    while [ "$i" -lt "${#filt_paths[@]}" ]; do
        f="${filt_paths[$i]}"
        if [ -f "$ROOT/$f" ]; then
            eval "${filt_cmds[$i]}" < "$ROOT/$f" | "${SSH[@]}" "mkdir -p $dir/$(dirname "$f") && cat > $dir/$f"
            say "  $f (filtered)"
        fi
        i=$((i + 1))
    done
    say "synced"
}

# stream the remote log from $1 (gen:lines, or -1 for the tail) until the run is over; survives Ctrl-C and dropped connections
follow() {
    local from=$1 hits=0 cnt pid rc
    cnt=$(mktemp)
    trap 'hits=$((hits + 1)); if [ $hits -eq 1 ]; then say "stopping $label (Ctrl-C again to kill)"; remote r_stop "$key" INT; else say "killing $label"; remote r_stop "$key" KILL; fi' INT
    while :; do
        # the reader ignores SIGINT so the terminal's Ctrl-C reaches only the trap above;
        # it keeps the count of lines shown so a reconnect resumes where the stream broke
        ( trap '' INT
          remote r_follow "$key" "$from" | awk -v f="$cnt" '
              !seen { seen = 1; if (index($0, "\001rrun:from=") == 1) { split($0, a, /[= ]/); base = a[2] + 0; gen = a[4]; next } }
              { print; fflush(); n++; printf "%s:%d\n", gen, base + n > f; close(f) }'
          exit "${PIPESTATUS[0]}" ) & pid=$!
        while :; do wait "$pid" && rc=0 || rc=$?; kill -0 "$pid" 2>/dev/null || break; done
        [ "$rc" -eq 0 ] && break
        from=$(cat "$cnt" 2>/dev/null || echo "$from")
        if remote r_pgid "$key" >/dev/null 2>&1; then say "connection lost, reconnecting"; sleep 1
        elif [ $? -eq 255 ]; then say "$target unreachable, retrying in 3s"; sleep 3
        fi
    done
    rm -f "$cnt"; trap - INT
}

run() {
    [ $# -gt 0 ] || { usage; exit 1; }
    sync
    say "starting $label on $target: $*"
    remote r_start "$key" "$dir" "$env" "$log_bytes" "$*"
    follow 0:0
    exit "$(remote r_exit "$key")"
}
# subcommands that take a run name positionally, docker style: rrun attach load
pick() { [ -n "${1:-}" ] && { run="$1"; key="$name/$1"; label="$(r_label "$key")"; } || true; }

case "${1:-}" in
    sync)        sync ;;
    setup)       remote r_setup "$dir"; sync ;;
    attach|logs) pick "${2:-}"; follow -1 ;;
    stop)        pick "${2:-}"; remote r_stop "$key" INT; follow -1 ;;
    kill)        pick "${2:-}"; remote r_stop "$key" KILL; say "killed $label" ;;
    status)      pick "${2:-}"; remote r_status "$key" ;;
    ps)          case "${2:-}" in -a|all) remote r_ps ;; *) remote r_ps "$name" ;; esac ;;
    clean)       if [ -n "${2:-}" ]; then remote r_clean "$name/$2"; else remote r_clean "$name"; fi ;;
    killall)     remote r_killall ;;
    exec)        shift; [ $# -gt 0 ] || die "exec: no command"; check_host
                 "${SSH[@]}" -t "cd $dir 2>/dev/null || cd; ${env:+export $env;} bash -lc $(printf '%q' "$*")" ;;
    sh|shell)    check_host; "${SSH[@]}" -t "cd $dir && exec bash -l" ;;
    init)        [ -e "$ROOT/.rrun.conf" ] && die ".rrun.conf already exists in $ROOT"; write_conf; say "wrote $ROOT/.rrun.conf" ;;
    run)         shift; [ "${1:-}" = "--" ] && shift; run "$@" ;;
    "")          usage; exit 1 ;;
    *)           run "$@" ;;
esac
