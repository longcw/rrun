# rrun host config, sourced by bash. Copy to ~/.config/rrun/config.
# A host is a name -> ssh target; `rrun -H <name>` or a project's .rrun.conf picks one,
# otherwise `default` is used. A name that is not defined here is used as an ssh target as-is.
default=vps
host_vps=root@us.long-ch.com
# ssh_opts_vps="-p 22 -i ~/.ssh/id_ed25519"   # extra ssh options for that host
